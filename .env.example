NODE_ENV=development
LOG_LEVEL=debug
HTTP_SLOW_THRESHOLD_MS=1000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_AUTH_ACCOUNT_MAX_REQUESTS=5
RATE_LIMIT_REFRESH_MAX_REQUESTS=20
RATE_LIMIT_FEED_MAX_REQUESTS=30
RATE_LIMIT_SEARCH_MAX_REQUESTS=60
RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_IDLE_TTL_MS=120000
# Keep 0 for direct traffic. Set only after verifying the trusted proxy hop count in staging.
RATE_LIMIT_TRUST_PROXY_HOPS=0
API_HOST=127.0.0.1
API_PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=newtine
DB_USER=postgres
DB_PASSWORD=postgres
# development/test may use disable; staging/production must use verify-full with a CA path.
DB_SSL_MODE=disable
DB_SSL_CA_PATH=
# Pipeline providers (NAVER API HUB for pipelineWorker; OpenAI for pipelineWorker/embeddingRepair)
# Enter Client ID / Client Secret issued by NAVER API HUB (not legacy developer-center keys).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=
PIPELINE_AI_CONFIG_PATH=config/pipeline-ai.yml
# Optional override for candidate/content/validation. Empty means stage YAML, then code fallback.
PIPELINE_AI_MODEL=
PIPELINE_WORKER_POLL_MS=1000
PIPELINE_WORKER_ONCE=0
# Set only after confirming the previous embedding-repair process is dead.
PIPELINE_EMBEDDING_REPAIR_RECLAIM_OWNER=
JWT_SECRET=replace-with-at-least-32-utf8-bytes
JWT_ISSUER=newtine-api
JWT_AUDIENCE=newtine-client
AUTH_COOKIE_SECURE=false
# Comma-separated absolute origins. Empty means same-origin validation from the request host.
AUTH_ALLOWED_ORIGINS=
# My Page interest analysis (Figma: recent seven days; server-configured threshold)
INTEREST_ANALYSIS_WINDOW_DAYS=7
INTEREST_ANALYSIS_MINIMUM_SAMPLE_SIZE=10
# Diagnostic report worker: optional model override; empty falls back to gpt-5.4-mini-2026-03-17.
REPORT_AI_MODEL=
REPORT_AI_TIMEOUT_MS=60000
REPORT_WORKER_POLL_MS=1000
REPORT_WORKER_LEASE_MS=180000
REPORT_WORKER_HEARTBEAT_MS=30000
REPORT_WORKER_EXECUTION_TIMEOUT_MS=300000
REPORT_WORKER_ONCE=0
