NODE_ENV=development
LOG_LEVEL=debug
HTTP_SLOW_THRESHOLD_MS=1000
API_HOST=127.0.0.1
API_PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=newtine
DB_USER=postgres
DB_PASSWORD=postgres
# Pipeline providers (Naver for pipelineWorker; OpenAI for pipelineWorker/embeddingRepair)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=
PIPELINE_AI_CONFIG_PATH=config/pipeline-ai.yml
PIPELINE_WORKER_POLL_MS=1000
PIPELINE_WORKER_ONCE=0
# Set only after confirming the previous embedding-repair process is dead.
PIPELINE_EMBEDDING_REPAIR_RECLAIM_OWNER=
