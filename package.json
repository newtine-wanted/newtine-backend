{
  "name": "newtine-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:api && npm run build:batch",
    "build:api": "ttsc -p apps/api/tsconfig.app.json",
    "build:batch": "ttsc -p apps/batch/tsconfig.app.json",
    "start:api": "node dist/apps/api/src/main.js",
    "start:batch": "node dist/apps/batch/src/main.js",
    "start:dev:api": "ttsx -P apps/api/tsconfig.app.json apps/api/src/main.ts",
    "format": "prettier --write \"{apps,libs,scripts,test}/**/*.{ts,mts,mjs,json}\" nestia.config.ts tsconfig.generated.json jest.config.mjs jest.transformer.mjs",
    "format:check": "prettier --check \"{apps,libs,scripts,test}/**/*.{ts,mts,mjs,json}\" nestia.config.ts tsconfig.generated.json jest.config.mjs jest.transformer.mjs",
    "lint": "eslint nestia.config.ts jest.config.mjs jest.transformer.mjs \"{apps,libs,scripts,test}/**/*.{ts,mts,mjs}\"",
    "typecheck": "ttsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:jest": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.mjs --runInBand",
    "test:contracts": "npm run test:jest -- test/contracts",
    "test:unit": "npm run test:jest -- test/unit",
    "test:integration": "npm run test:jest -- test/integration",
    "test:smoke": "node scripts/smoke.mjs",
    "typecheck:generated": "tsc --noEmit -p tsconfig.generated.json",
    "contracts:sdk": "nestia sdk",
    "contracts:swagger": "node scripts/openapi.mjs",
    "contracts:e2e": "nestia e2e",
    "contracts:all": "npm run contracts:sdk && npm run contracts:e2e && npm run contracts:swagger",
    "contracts:check": "npm run contracts:all && npm run test:contracts && npm run typecheck:generated"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.0",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.0",
    "@nestia/core": "^13.0.2",
    "@nestia/fetcher": "^13.0.2",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "nestjs-pino": "^5.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typia": "^14.0.6",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestia/sdk": "^13.0.2",
    "@nestjs/testing": "12.0.1",
    "@ttsc/paths": "^0.30.1",
    "@types/express": "5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "24.0.0",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "^30.4.2",
    "nestia": "^13.0.2",
    "pino-pretty": "^13.1.3",
    "prettier": "3.6.2",
    "ttsc": "^0.30.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "optionalDependencies": {
    "@typescript/typescript-aix-ppc64": "7.0.2",
    "@typescript/typescript-darwin-arm64": "7.0.2",
    "@typescript/typescript-darwin-x64": "7.0.2",
    "@typescript/typescript-freebsd-arm64": "7.0.2",
    "@typescript/typescript-freebsd-x64": "7.0.2",
    "@typescript/typescript-linux-arm": "7.0.2",
    "@typescript/typescript-linux-arm64": "7.0.2",
    "@typescript/typescript-linux-loong64": "7.0.2",
    "@typescript/typescript-linux-mips64el": "7.0.2",
    "@typescript/typescript-linux-ppc64": "7.0.2",
    "@typescript/typescript-linux-riscv64": "7.0.2",
    "@typescript/typescript-linux-s390x": "7.0.2",
    "@typescript/typescript-linux-x64": "7.0.2",
    "@typescript/typescript-netbsd-arm64": "7.0.2",
    "@typescript/typescript-netbsd-x64": "7.0.2",
    "@typescript/typescript-openbsd-arm64": "7.0.2",
    "@typescript/typescript-openbsd-x64": "7.0.2",
    "@typescript/typescript-sunos-x64": "7.0.2",
    "@typescript/typescript-win32-arm64": "7.0.2",
    "@typescript/typescript-win32-x64": "7.0.2"
  }
}
